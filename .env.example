# Sandbox only. Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Use the sandbox PERSONAL account in the PayPal popup, not the business account that owns the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional. Any OpenAI-compatible chat model. Powers the worker and the reviewer.
# The reviewer is not told the bounty, and neither call receives a PayPal tool.
# Groq example:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# Signs the one-time permit that allows a PayPal order. Change this before you deploy.
MANDATE_SECRET=change-me
